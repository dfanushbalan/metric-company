# Application Configuration
FLASK_ENV=development
PORT=5000
DEBUG=True

# Database Configuration (MySQL)
# Set DB_TYPE to 'mysql' to use MySQL, or 'sqlite' for quick local testing without MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=appointment_db

# Optional Cloud Database URI (Overrides individual DB settings if provided)
# Works with Render PostgreSQL, Railway, Neon, Supabase, or cloud MySQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# Fallback setting: If True, backend will automatically fall back to SQLite if MySQL is unreachable
AUTO_FALLBACK_SQLITE=True

